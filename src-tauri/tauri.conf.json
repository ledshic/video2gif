{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Video2GIF",
  "version": "1.0.0",
  "identifier": "com.ledshic.video2gif",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:5173",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Video2GIF",
        "width": 920,
        "height": 720,
        "minWidth": 720,
        "minHeight": 560,
        "resizable": true,
        "fullscreen": false,
        "label": "main"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico",
      "icons/icon.png"
    ],
    "resources": [
      "../resources/ffmpeg/**/*"
    ],
    "linux": {
      "deb": {
        "depends": []
      }
    },
    "externalBin": []
  }
}
