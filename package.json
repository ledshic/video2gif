{
  "name": "video2gif",
  "private": true,
  "version": "1.0.0",
  "description": "跨平台视频转 GIF 桌面应用（Tauri 2 + Vite + React）",
  "author": "ledshic",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "tauri": "tauri",
    "prepare:ffmpeg": "node scripts/prepare-ffmpeg.mjs",
    "pretauri:dev": "npm run prepare:ffmpeg",
    "tauri:dev": "tauri dev",
    "pretauri:build": "npm run prepare:ffmpeg",
    "tauri:build": "tauri build",
    "smoke": "cargo test -p video-sdk --test smoke_convert -- --nocapture",
    "sdk:test": "cargo test -p video-sdk",
    "check:rust": "cargo check -p video-sdk && cargo check -p video2gif"
  },
  "dependencies": {
    "@tauri-apps/api": "^2",
    "@tauri-apps/plugin-dialog": "^2",
    "@tauri-apps/plugin-fs": "^2",
    "@tauri-apps/plugin-opener": "^2",
    "@video2gif/sdk": "file:packages/video-sdk",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@ffprobe-installer/ffprobe": "^2.1.2",
    "@tauri-apps/cli": "^2",
    "@types/node": "^26.6.2",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "esbuild": "^0.28.2",
    "ffmpeg-static": "^5.3.0",
    "oxlint": "^1.81.0",
    "typescript": "~5.8.3",
    "vite": "^8.3.0"
  }
}
